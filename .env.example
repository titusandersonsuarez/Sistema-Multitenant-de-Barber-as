# Copia este archivo como .env y cambia los valores.
POSTGRES_PASSWORD=cambia-esta-clave
# Mínimo 32 caracteres. Genera uno con: openssl rand -base64 48
JWT_SECRET=
# Opcional: acceso de superadministrador a /api/superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
# true solo para la demo pública: crea /barberia-demo con usuario y clave conocidos.
DEMO_ENABLED=false
